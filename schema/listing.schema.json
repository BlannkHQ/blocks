{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "$id":"https://blannk.com/blocks/listing.schema.json",
 "title":"Blannk public catalog listing v1 (not an OS runtime manifest)",
 "type":"object","additionalProperties":false,
 "required":["schemaVersion","visibility","id","slug","name","summary","description","category","tags","author","version","license","repository","commit","path","minOsVersion","permissions","updatedAt"],
 "properties":{
  "$schema":{"const":"https://blannk.com/blocks/listing.schema.json"},
  "schemaVersion":{"const":1},"visibility":{"const":"public"},
  "id":{"type":"string","pattern":"^user\\.[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$","maxLength":120},
  "slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":80},
  "name":{"type":"string","minLength":2,"maxLength":60},
  "summary":{"type":"string","minLength":15,"maxLength":160},
  "description":{"type":"string","minLength":30,"maxLength":5000},
  "category":{"enum":["Productivity","Developer tools","Utilities","Appearance"]},
  "tags":{"type":"array","minItems":1,"maxItems":6,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":30}},
  "author":{"type":"string","pattern":"^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$"},
  "version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
  "license":{"enum":["MIT","Apache-2.0","BSD-2-Clause","BSD-3-Clause","ISC","MPL-2.0","GPL-3.0-only","GPL-3.0-or-later","AGPL-3.0-only","AGPL-3.0-or-later","Unlicense","CC0-1.0"]},
  "repository":{"type":"string","pattern":"^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$","maxLength":240},
  "commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},
  "path":{"type":"string","pattern":"^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$","maxLength":160},
  "minOsVersion":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
  "permissions":{"type":"array","maxItems":12,"uniqueItems":true,"items":{"enum":["own-data","notifications","scheduled-reminders","network","user-selected-files","device-actions"]}},
  "updatedAt":{"type":"string","format":"date"}
 }
}
