{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blannk.com/blocks/listing.schema.json",
  "title": "BLANNK public catalog listing v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "visibility",
    "id",
    "slug",
    "name",
    "summary",
    "description",
    "category",
    "tags",
    "author",
    "version",
    "license",
    "repository",
    "commit",
    "path",
    "minOsVersion",
    "permissions",
    "updatedAt"
  ],
  "properties": {
    "$schema": {
      "const": "https://blannk.com/blocks/listing.schema.json"
    },
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "visibility": {
      "const": "public"
    },
    "id": {
      "type": "string",
      "pattern": "^user\\.[a-z0-9-]+\\.[a-z0-9-]+$",
      "maxLength": 120
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 15,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 30,
      "maxLength": 5000
    },
    "category": {
      "enum": [
        "Productivity",
        "Developer tools",
        "Utilities",
        "Appearance",
        "Games"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 30
      }
    },
    "author": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "license": {
      "enum": [
        "MIT",
        "Apache-2.0",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "ISC",
        "MPL-2.0",
        "GPL-3.0-only",
        "GPL-3.0-or-later",
        "AGPL-3.0-only",
        "AGPL-3.0-or-later",
        "Unlicense",
        "CC0-1.0"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 240
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$",
      "maxLength": 160
    },
    "minOsVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "permissions": {
      "type": "array",
      "maxItems": 19,
      "uniqueItems": true,
      "items": {
        "enum": [
          "account-security",
          "audio-control",
          "bluetooth-control",
          "camera",
          "clipboard-read",
          "clipboard-write",
          "device-actions",
          "display-control",
          "input-injection",
          "microphone",
          "network",
          "network-control",
          "notifications",
          "own-data",
          "power-control",
          "scheduled-reminders",
          "screen-capture",
          "system-info",
          "user-selected-files"
        ]
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$"
    },
    "authorProfile": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "publisherProfile": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "contributors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$"
      }
    },
    "authorId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Optional stable numeric GitHub account ID. Maintainer verification is required; self-declared metadata is not proof of identity."
    },
    "publisherId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Optional stable numeric GitHub account ID. Maintainer verification is required; self-declared metadata is not proof of identity."
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "icon": {
          "type": "string",
          "enum": [
            "app-window",
            "timer",
            "calendar",
            "notebook-pen",
            "file-text",
            "list-checks",
            "activity",
            "terminal",
            "code",
            "music",
            "image",
            "mail",
            "folder",
            "network"
          ]
        },
        "screenshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "alt"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\:#?])[A-Za-z0-9_./ -]+\\.png$"
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            }
          }
        }
      }
    },
    "presentationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screenshot"
      ],
      "properties": {
        "screenshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "width",
            "height",
            "mediaType"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "mediaType": {
              "const": "image/png"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "presentation": false,
          "presentationEvidence": false
        }
      }
    }
  ]
}
