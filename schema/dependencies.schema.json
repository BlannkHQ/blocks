{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BLANNK explicit distribution/dependencies v1 snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "files",
    "qmlModules",
    "qmlImportPaths",
    "pythonPaths",
    "libraryPaths",
    "bundled",
    "dynamicAssets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^/]+(?:/[^/]+)*$"
      }
    },
    "qmlModules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "version",
          "provider"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "provider": {
            "enum": [
              "host",
              "bundled"
            ]
          }
        }
      }
    },
    "bundled": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source",
          "revision",
          "license",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^/]+(?:/[^/]+)*$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "qmlImportPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^/]+(?:/[^/]+)*$"
      }
    },
    "pythonPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^/]+(?:/[^/]+)*$"
      }
    },
    "libraryPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^/]+(?:/[^/]+)*$"
      }
    },
    "dynamicAssets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^/]+(?:/[^/]+)*$"
      }
    }
  }
}
